---
import MainLayout from './MainLayout.astro';
import { Sidebar } from '../components/Sidebar';
import { Search, Bell, User, MessageSquare } from 'lucide-react';

interface Props {
  title?: string;
  activeDept?: string;
}

const { title, activeDept } = Astro.props;
---

<MainLayout title={title}>
  <div class="flex min-h-screen bg-white">
    <Sidebar client:load />
    
    <div class="flex-1 transition-all duration-300 ml-[280px] bg-white min-h-screen">
      <!-- Topbar -->
      <header class="h-20 flex items-center justify-between px-10 bg-white border-b border-slate-100 sticky top-0 z-40 shadow-[0_1px_2px_rgba(0,0,0,0.02)]">
        <div class="flex items-center gap-4">
          <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tighter">{title}</h2>
          {activeDept && (
            <span class="px-3 py-1 rounded-lg bg-violet-50 text-violet-600 text-[11px] font-black uppercase tracking-widest border border-violet-100">
               {activeDept}
            </span>
          )}
        </div>
        
        <div class="flex items-center gap-8">
          <!-- Main Search Hub -->
          <div class="hidden lg:flex items-center px-5 py-2.5 bg-slate-50 border border-slate-100 rounded-2xl focus-within:border-violet-500/50 focus-within:bg-white transition-all w-96 shadow-inner group">
            <Search className="text-slate-600 w-4 h-4 mr-3 group-focus-within:text-violet-600 transition-colors" />
            <input 
              type="text" 
              placeholder="NEURAL SEARCH PROTOCOL..." 
              class="bg-transparent border-none focus:outline-none text-[11px] font-black uppercase tracking-widest text-slate-900 placeholder-slate-400 w-full"
            />
          </div>

          <div class="flex items-center gap-3">
             <button class="w-11 h-11 rounded-2xl bg-white border border-slate-100 flex items-center justify-center text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all relative shadow-sm active:scale-95">
                <Bell size={20} />
                <span class="absolute top-3 right-3 w-2.5 h-2.5 rounded-full bg-rose-500 border-2 border-white shadow-lg"></span>
             </button>
             <button class="w-11 h-11 rounded-2xl bg-white border border-slate-100 flex items-center justify-center text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all shadow-sm active:scale-95">
                <MessageSquare size={20} />
             </button>
          </div>
          
          <div class="flex items-center gap-4 pl-8 border-l border-slate-100 ml-4 group cursor-pointer">
             <div class="text-right hidden xl:block">
                <p class="text-[12px] font-black text-slate-900 uppercase tracking-tighter leading-none mb-1.5 group-hover:text-violet-600 transition-colors">Praneeth Kumar</p>
                <p class="text-[10px] text-violet-500 font-black uppercase tracking-widest leading-none opacity-80">Principal Architect • Hub Admin</p>
             </div>
             <div class="w-11 h-11 rounded-2xl bg-violet-600 flex items-center justify-center text-white shadow-xl shadow-violet-600/30 ring-2 ring-white hover:scale-105 transition-all">
                <User size={22} />
             </div>
          </div>
        </div>
      </header>

      <!-- Page Content -->
      <main class="p-8 pb-12 max-w-7xl mx-auto">
        <slot />
      </main>
    </div>
  </div>
</MainLayout>

<style>
  div :global(.ml-\[88px\]-sidebar) {
     margin-left: 88px;
  }
</style>






