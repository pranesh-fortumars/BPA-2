---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { motion } from 'framer-motion';
import { Users, UserPlus, Shield, Globe, Search, MoreVertical } from 'lucide-react';
---

<DashboardLayout title="Organization Management">
  <div class="space-y-12">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-[10px] font-black text-violet-500 uppercase tracking-widest mb-3">
               <span>Directory</span>
               <span class="text-slate-300">/</span>
               <span class="text-slate-600">Enterprise</span>
            </div>
            <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter">Organization Hub</h1>
            <p class="text-slate-700 font-medium mt-1">Manage structure, roles, and enterprise governance</p>
        </div>
        <button class="px-8 py-3.5 bg-violet-600 hover:bg-violet-500 text-white text-[10px] font-black uppercase tracking-widest rounded-2xl flex items-center gap-3 shadow-xl shadow-violet-600/20 transition-all active:scale-95">
            <UserPlus size={18} /> Invite New Member
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
            { label: 'Total Members', value: '1,248', icon: Users, color: 'text-violet-600', bg: 'bg-violet-50' },
            { label: 'Active Sessions', value: '412', icon: Globe, color: 'text-emerald-600', bg: 'bg-emerald-50' },
            { label: 'Admin Roles', value: '24', icon: Shield, color: 'text-amber-600', bg: 'bg-amber-50' },
        ].map(stat => (
            <div class="bg-white border border-slate-200 p-8 rounded-[2.5rem] shadow-sm hover:shadow-xl transition-all group">
                <div class="flex items-center gap-6">
                    <div class={`p-4 rounded-2xl ${stat.bg} ${stat.color} border border-white shadow-sm group-hover:scale-110 transition-transform`}>
                        <stat.icon size={28} />
                    </div>
                    <div>
                        <p class="text-[10px] font-black text-slate-600 uppercase tracking-widest mb-1.5">{stat.label}</p>
                        <p class="text-3xl font-black text-slate-900 tracking-tighter leading-none">{stat.value}</p>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <div class="bg-white border border-slate-200 rounded-[3rem] overflow-hidden shadow-sm">
        <div class="p-8 border-b border-slate-100 flex flex-col lg:flex-row justify-between items-center bg-white/50 gap-6">
            <div class="relative group">
                <Search class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-600 group-hover:text-slate-900 transition-colors" size={18} />
                <input type="text" placeholder="Filter members..." class="pl-14 pr-6 py-4 bg-white border border-slate-200 rounded-2xl text-[10px] font-black uppercase tracking-widest text-slate-900 focus:outline-none focus:border-violet-500/50 w-96 shadow-inner" />
            </div>
            <div class="flex gap-3">
                <button class="px-6 py-3 bg-white text-slate-700 rounded-xl text-[10px] font-black uppercase tracking-widest border border-slate-200 hover:text-slate-900 hover:bg-white transition-all shadow-sm">All Departments</button>
                <button class="px-6 py-3 bg-white text-slate-700 rounded-xl text-[10px] font-black uppercase tracking-widest border border-slate-200 hover:text-slate-900 hover:bg-white transition-all shadow-sm">Last Active</button>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[10px] font-black text-slate-600 uppercase tracking-widest border-b border-slate-100 bg-white/30">
                        <th class="px-10 py-6">Identity</th>
                        <th class="px-10 py-6">Department</th>
                        <th class="px-10 py-6">Role</th>
                        <th class="px-10 py-6">System Status</th>
                        <th class="px-10 py-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {[
                        { name: 'Praneeth Kumar', email: 'pk@bpa.pro', dept: 'Operations', role: 'HQ Admin', status: 'Online' },
                        { name: 'Sarah Jenkins', email: 'sj@bpa.pro', dept: 'HR', role: 'Manager', status: 'Offline' },
                        { name: 'Michael Ross', email: 'mr@bpa.pro', dept: 'Finance', role: 'Approver', status: 'Online' },
                        { name: 'Emma Wilson', email: 'ew@bpa.pro', dept: 'Engineering', role: 'DevOps', status: 'Away' }
                    ].map(user => (
                        <tr class="hover:bg-white transition-all cursor-pointer group">
                            <td class="px-10 py-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-[10px] font-black text-slate-600 uppercase shadow-sm">
                                        {user.name.split(' ').map(n => n[0]).join('')}
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-sm font-black text-slate-900 group-hover:text-violet-600 transition-colors uppercase tracking-tight truncate">{user.name}</p>
                                        <p class="text-[10px] text-slate-600 font-black uppercase tracking-widest leading-none mt-1">{user.email}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-10 py-6">
                               <span class="px-3 py-1.5 rounded-xl bg-white text-slate-600 text-[9px] font-black uppercase tracking-widest border border-slate-200 shadow-sm">{user.dept}</span>
                            </td>
                            <td class="px-10 py-6">
                               <span class="text-[10px] font-black text-violet-600 uppercase tracking-widest">{user.role}</span>
                            </td>
                            <td class="px-10 py-6">
                                <div class="flex items-center gap-2">
                                    <div class={`w-2 h-2 rounded-full ${user.status === 'Online' ? 'bg-emerald-500 shadow-[0_0_8px_#10b981]' : 'bg-slate-300'}`}></div>
                                    <span class="text-[10px] font-black text-slate-700 uppercase tracking-tight">{user.status}</span>
                                </div>
                            </td>
                            <td class="px-10 py-6 text-right">
                                <button class="p-3 rounded-xl bg-white text-slate-600 hover:text-slate-900 border border-slate-100 transition-all">
                                    <MoreVertical size={18} />
                                </button>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
  </div>
</DashboardLayout>





