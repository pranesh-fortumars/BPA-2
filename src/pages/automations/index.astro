---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { AutomationsHub } from '../../components/operations/AutomationsHub';
---

<DashboardLayout title="Automations Hub" activeDept="Automation">
  <div class="mb-8">
    <h1 class="text-3xl font-black text-foreground tracking-tight mb-2">Automations <span class="text-primary">Hub</span></h1>
