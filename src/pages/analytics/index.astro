---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { AnalyticsHub } from '../../components/AnalyticsHub';
import { ProcessIntelligence } from '../../components/ProcessIntelligence';
import { Activity, Brain, Target, BarChart2 } from 'lucide-react';
---

<DashboardLayout title="Performance Intelligence & Mining">
  <div class="space-y-12">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-10 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-[10px] font-black text-violet-500 uppercase tracking-widest mb-3">
               <span>Intelligence</span>
               <span class="text-slate-300">/</span>
               <span class="text-slate-600">Process Mining</span>
            </div>
            <h1 class="text-5xl font-black text-slate-900 uppercase tracking-tighter">Enterprise Intelligence Hub</h1>
            <p class="text-slate-700 font-medium text-lg mt-1">AI-native process mining, cycle analysis, and neural-performance diagnostics</p>
        </div>
        <div class="flex bg-white p-1.5 rounded-[2rem] border border-slate-200 shadow-sm mb-2">
            {['Performance', 'Process Mining', 'Neural Insights'].map((tab) => (
                <button class={`px-8 py-3.5 text-[10px] font-black uppercase tracking-widest rounded-2xl transition-all active:scale-95 ${tab === 'Performance' ? 'bg-violet-600 text-white shadow-xl shadow-violet-600/20' : 'text-slate-600 hover:text-slate-900 hover:bg-white'}`}>
                    {tab}
                </button>
            ))}
        </div>
    </div>

    {/* Section: Conventional Performance Hub */}
    <section class="space-y-8">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-2.5 h-10 bg-violet-600 rounded-full shadow-[0_0_10px_#4f46e5]"></div>
                <div>
                   <h2 class="text-3xl font-black text-slate-900 uppercase tracking-tighter leading-none">Operational Performance Matrix</h2>
                   <p class="text-[10px] text-slate-600 font-black uppercase tracking-widest mt-2">Real-time throughput and error rate monitoring across clusters</p>
                </div>
            </div>
            <button class="px-6 py-2.5 bg-white text-slate-900 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-black transition-all shadow-xl shadow-slate-900/10">Configure Metrics</button>
        </div>
        <div class="bg-white border border-slate-200 rounded-[3rem] p-8 shadow-sm">
           <AnalyticsHub client:load />
        </div>
    </section>

    {/* Section: Professional Process Intelligence & Mining */}
    <section class="space-y-10 pt-16 border-t border-slate-100">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-2.5 h-10 bg-rose-600 rounded-full shadow-[0_0_10px_#e11d48]"></div>
                <div>
                   <h2 class="text-3xl font-black text-slate-900 uppercase tracking-tighter leading-none">Process Mining & Bottleneck Detection</h2>
                   <p class="text-[10px] text-slate-600 font-black uppercase tracking-widest mt-2">Visual throughput analysis and congestion mapping across operational sectors</p>
                </div>
            </div>
            <div class="flex gap-2">
               <div class="px-5 py-3 bg-rose-50 border border-rose-100 rounded-2xl flex items-center gap-3 text-rose-600 text-[10px] font-black uppercase tracking-widest shadow-sm">
                  <div class="w-2 h-2 rounded-full bg-rose-600 animate-pulse shadow-[0_0_8px_#e11d48]"></div>
                  Neural Observation Active
               </div>
            </div>
        </div>
        <div class="bg-white border border-slate-200 rounded-[3rem] p-8 shadow-sm min-h-[500px]">
           <ProcessIntelligence client:load />
        </div>
    </section>
  </div>
</DashboardLayout>






