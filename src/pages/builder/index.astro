---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { WorkflowBuilder } from '../../components/WorkflowBuilder';
import { 
  History, 
  Settings, 
  Play, 
  Trash2, 
  Copy, 
  Share2,
  ChevronDown
} from 'lucide-react';
---

<DashboardLayout title="No-Code Process Orchestrator">
  <!-- Contextual Header for the Builder -->
  <!-- Contextual Header for the Builder -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-8 bg-white p-8 rounded-[3rem] border border-slate-200 shadow-sm relative overflow-hidden group">
    <div class="absolute top-0 right-0 w-32 h-32 bg-violet-50 rounded-full blur-3xl -mr-16 -mt-16 group-hover:scale-150 transition-transform"></div>
    <div class="flex items-center gap-6 relative z-10">
      <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-slate-900 shadow-xl shadow-slate-900/10">
        <Settings className="w-8 h-8" />
      </div>
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-black text-slate-900 uppercase tracking-tighter">Invoice Approval Chain</h1>
          <span class="text-[9px] font-black text-violet-600 bg-violet-50 border border-violet-100 px-3 py-1.5 rounded-xl uppercase tracking-widest shadow-sm">Draft v2.4</span>
        </div>
        <p class="text-slate-600 text-[10px] font-black uppercase tracking-widest mt-2 flex items-center gap-2">
           <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-sm"></span>
           Last edited by <span class="text-violet-600 font-black">Praneeth K.</span> • 12 minutes ago
        </p>
      </div>
    </div>
    
    <div class="flex items-center gap-4 relative z-10">
        <div class="flex gap-2">
            <button class="p-4 bg-white hover:bg-white rounded-2xl text-slate-600 hover:text-slate-900 border border-slate-200 transition-all shadow-sm active:scale-95">
               <History size={20} />
            </button>
            <button class="p-4 bg-white hover:bg-white rounded-2xl text-slate-600 hover:text-slate-900 border border-slate-200 transition-all shadow-sm active:scale-95">
               <Share2 size={20} />
            </button>
        </div>
        <div class="h-10 w-[1px] bg-white mx-1"></div>
        <button class="flex items-center gap-3 px-8 py-4 bg-violet-600 hover:bg-violet-500 rounded-[2rem] font-black text-white text-[10px] uppercase tracking-widest shadow-xl shadow-violet-600/20 transition-all active:scale-95 group overflow-hidden relative">
           <Play size={18} fill="currentColor" class="relative z-10" />
           <span class="relative z-10">Deploy Protocol</span>
           <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
        </button>
    </div>
  </div>

  <!-- Builder Main Area -->
  <div class="relative bg-white border border-slate-200 rounded-[3rem] p-4 shadow-inner min-h-[600px] group overflow-hidden">
     <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
    <WorkflowBuilder client:only="react" />
  </div>

  <!-- Secondary Actions -->
  <div class="mt-8 flex flex-col md:flex-row justify-between items-center gap-6 pb-2">
    <div class="flex gap-4">
      <button class="text-[9px] font-black text-slate-600 uppercase tracking-widest hover:text-slate-900 py-2.5 px-6 bg-white border border-slate-200 rounded-xl shadow-sm transition-all flex items-center gap-3 active:scale-95">
         <Copy size={16} class="text-violet-600" /> Duplicate Blueprint
      </button>
      <button class="text-[9px] font-black text-rose-500 hover:text-slate-900 py-2.5 px-6 bg-rose-50 hover:bg-rose-600 border border-rose-100 rounded-xl shadow-sm transition-all flex items-center gap-3 active:scale-95">
         <Trash2 size={16} /> Delete Draft
      </button>
    </div>
    <div class="flex items-center gap-3 text-[9px] uppercase font-black tracking-widest text-slate-600 bg-white px-6 py-2.5 rounded-full border border-slate-100 shadow-inner">
       <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_#10b981]"></div>
       Cloud Auto-saved 14:22:15
    </div>
  </div>
</DashboardLayout>

<style>
  /* Fix for React Flow rendering issue in Astro */
  :global(.react-flow) {
    background: transparent !important;
  }
</style>






