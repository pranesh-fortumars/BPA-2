---
import ClientPortalLayout from '../../layouts/ClientPortalLayout.astro';
import { ClientPortalOverview } from '../../components/crm/ClientPortalOverview';
---

<ClientPortalLayout title="Client Portal | Acme Corp">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tighter uppercase">Project HQ</h1>
        <p class="text-[11px] font-black uppercase tracking-widest text-slate-500 mt-1">Track progress, approve milestones, and view invoices.</p>
      </div>
      <div class="flex items-center gap-3">
        <button class="px-5 py-2.5 bg-violet-600 rounded-xl text-xs font-black uppercase tracking-widest text-white hover:bg-violet-500 transition-all shadow-lg shadow-violet-600/30 active:scale-95 flex items-center gap-2">
          Raise Ticket
        </button>
      </div>
    </div>

    <!-- React Island for Client Portal interactivity -->
    <ClientPortalOverview client:load />
    
  </div>
</ClientPortalLayout>
