---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { 
  ClipboardList, 
  History, 
  Lock, 
  ShieldCheck, 
  Search, 
  Filter, 
  Download, 
  AlertTriangle,
  UserCheck,
  Globe,
  Database,
  ArrowRight
} from 'lucide-react';
---

<DashboardLayout title="Compliance & Global Audit Trail">
  <div class="space-y-12 pb-32">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-10">
        <div>
            <div class="flex items-center gap-4 mb-4">
               <div class="p-4 bg-violet-600 rounded-3xl text-white shadow-xl shadow-violet-600/20">
                  <ClipboardList size={32} />
               </div>
               <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter">Global Audit Sovereignty</h1>
            </div>
            <p class="text-slate-700 text-lg font-medium max-w-2xl">Immutable ledger for enterprise governance, departmental traceability, and real-time compliance monitoring across all neural nodes.</p>
        </div>
        <div class="flex gap-4">
            <button class="px-8 py-4 bg-white border border-slate-200 text-slate-600 rounded-[2rem] font-black uppercase tracking-widest text-[10px] shadow-sm flex items-center gap-3 transition-all hover:bg-white">
                <History size={14} /> Full Rollback History
            </button>
            <button class="px-8 py-4 bg-violet-600 hover:bg-violet-500 text-white rounded-[2rem] font-black uppercase tracking-widest text-xs shadow-2xl shadow-violet-600/20 flex items-center gap-3 transition-all active:scale-95 group">
                <Download size={20} class="group-hover:translate-y-1 transition-transform" /> 
                Export Forensic Report
            </button>
        </div>
    </div>

    {/* Compliance Pulse */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
            { label: 'Audit Purity', val: '99.98%', icon: ShieldCheck, color: 'text-emerald-600', bg: 'bg-emerald-50' },
            { label: 'IP Trace Match', val: '100%', icon: Globe, color: 'text-violet-600', bg: 'bg-violet-50' },
            { label: 'Ledger Blocks', val: '14.2M', icon: Database, color: 'text-purple-600', bg: 'bg-purple-50' },
            { label: 'SLA Deviations', val: '0.02%', icon: AlertTriangle, color: 'text-rose-600', bg: 'bg-rose-50' },
        ].map(stat => (
            <div class="bg-white border border-slate-200 p-8 rounded-[2.5rem] relative overflow-hidden group shadow-sm hover:shadow-xl transition-all">
                 <div class="flex justify-between items-start mb-6">
                    <div class={`p-3 rounded-2xl ${stat.bg} ${stat.color} border border-white shadow-sm`}>
                       <stat.icon size={24} />
                    </div>
                    <div class="text-[10px] font-black text-slate-600 uppercase tracking-widest">Live Ledger</div>
                 </div>
                 <p class="text-[10px] font-black text-slate-700 uppercase tracking-widest leading-none mb-2">{stat.label}</p>
                 <h3 class="text-3xl font-black text-slate-900 tracking-tighter">{stat.val}</h3>
            </div>
        ))}
    </div>

    {/* Immutable Event Ledger */}
    <div class="bg-white border border-slate-200 rounded-[3rem] overflow-hidden shadow-sm">
        <div class="p-10 border-b border-slate-100 flex justify-between items-center bg-white/50">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-slate-900">
                   <Lock size={18} />
                </div>
                <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tighter">Immutable Event Ledger</h2>
            </div>
            <div class="relative group">
               <Search class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-600 group-hover:text-slate-900 transition-colors" size={16} />
               <input type="text" placeholder="Search Trace ID / IP..." class="pl-14 pr-6 py-4 bg-white border border-slate-200 rounded-2xl text-[10px] font-black uppercase tracking-widest text-slate-900 focus:outline-none focus:border-violet-500/50 transition-all w-96 shadow-inner" />
            </div>
        </div>
        <div class="w-full overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[10px] font-black text-slate-600 uppercase tracking-widest border-b border-slate-100 bg-white/30">
                        <th class="px-10 py-6">Timestamp / Trace ID</th>
                        <th class="px-10 py-6">Orchestration Action</th>
                        <th class="px-10 py-6">Actor Identity</th>
                        <th class="px-10 py-6">Department</th>
                        <th class="px-10 py-6 text-right">Ledger Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {[
                        { time: '2026-04-02 10:52:01', trace: 'TR-9412-A', action: 'Manager Approval Override', actor: 'Praneeth K.', dept: 'HQ Admin', status: 'Sealed' },
                        { time: '2026-04-02 10:50:44', trace: 'TR-9411-X', action: 'API Connection Rotated', actor: 'System (AI)', dept: 'Infrastructure', status: 'Sealed' },
                        { time: '2026-04-02 10:48:12', trace: 'TR-9410-F', action: 'Invoice Extracted (OCR)', actor: 'Neural-Bot-4', dept: 'Finance Hub', status: 'Sealed' },
                        { time: '2026-04-02 10:45:00', trace: 'TR-9409-Q', action: 'User Access Provisioned', actor: 'Sarah J.', dept: 'Human Res', status: 'Sealed' },
                        { time: '2026-04-02 10:42:31', trace: 'TR-9408-B', action: 'Workflow Definition Modified', actor: 'Praneeth K.', dept: 'HQ Admin', status: 'Sealed' },
                    ].map(log => (
                        <tr class="hover:bg-white transition-all cursor-pointer group">
                            <td class="px-10 py-8">
                               <div class="flex items-center gap-4">
                                  <div class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_#10b981]"></div>
                                  <div class="font-mono">
                                     <p class="text-sm font-black text-slate-900 tracking-tight">{log.time.split(' ')[1]}</p>
                                     <p class="text-[9px] text-slate-600 font-black uppercase tracking-widest">{log.trace}</p>
                                  </div>
                               </div>
                            </td>
                            <td class="px-10 py-8">
                               <p class="text-sm font-black text-slate-900 uppercase tracking-tight group-hover:text-violet-600 transition-colors">{log.action}</p>
                               <p class="text-[10px] text-slate-600 font-black uppercase tracking-widest leading-none mt-1">Policy Identity: Verified</p>
                            </td>
                            <td class="px-10 py-8 flex items-center gap-3">
                               <div class="w-9 h-9 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[10px] font-black text-slate-600 uppercase shadow-sm">{log.actor.split(' ').map(n => n[0]).join('')}</div>
                               <span class="text-sm font-black text-slate-900 tracking-tight">{log.actor}</span>
                            </td>
                            <td class="px-10 py-8 text-slate-700 font-black text-[10px] uppercase tracking-widest">{log.dept}</td>
                            <td class="px-10 py-8 text-right">
                               <div class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 border border-emerald-100 rounded-xl text-emerald-600 text-[9px] font-black uppercase tracking-widest shadow-sm">
                                  <ShieldCheck size={12} /> {log.status}
                               </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>

    {/* Section: Compliance Warning */}
    <div class="p-12 rounded-[3.5rem] bg-rose-50 border border-rose-100 flex flex-col md:flex-row items-center justify-between gap-12 shadow-sm relative overflow-hidden">
       <div class="absolute top-0 right-0 w-64 h-64 bg-rose-200/20 blur-[100px] rounded-full translate-x-1/2 -translate-y-1/2"></div>
       <div class="flex items-center gap-8 relative z-10">
          <div class="w-24 h-24 bg-rose-600 rounded-[2.5rem] flex items-center justify-center shadow-2xl shadow-rose-600/30 border-4 border-white">
             <AlertTriangle class="text-slate-900" size={44} />
          </div>
          <div>
             <h3 class="text-3xl font-black text-rose-600 uppercase tracking-tighter">Anomaly Detection Warning</h3>
             <p class="text-slate-600 text-base font-medium max-w-xl mt-1 leading-relaxed">Forensic analysis identified a series of <span class="text-rose-600 font-black">non-ledgered transactions</span> in Audit Cluster Alpha. Immediate identity verification required.</p>
          </div>
       </div>
       <button class="px-12 py-5 bg-white hover:bg-black text-white rounded-2xl font-black uppercase tracking-widest text-[10px] shadow-2xl flex items-center gap-3 transition-all relative z-10">
          Investigate Breach <ArrowRight size={20} />
       </button>
    </div>
  </div>
</DashboardLayout>






