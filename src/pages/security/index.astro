---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { ShieldAlert, Key, Activity, RefreshCw, Lock, LayoutGrid, CheckCircle2 } from 'lucide-react';
---

<DashboardLayout title="Security & Access" activeDept="Settings">
  <div class="space-y-12 font-sans">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 pb-2 border-b border-border">
        <div>
            <div class="flex items-center gap-2 text-[10px] font-black text-primary uppercase tracking-widest mb-3">
               <span>Compliance</span>
               <span class="text-muted">/</span>
               <span class="text-foreground">Governance</span>
            </div>
            <h1 class="text-4xl font-black text-foreground uppercase tracking-tighter">Security Governance</h1>
            <p class="text-muted font-medium mt-1">Access control, threat detection, and enterprise encryption</p>
        </div>
        <div class="flex gap-3">
            <button class="px-6 py-3 bg-surface border border-border text-foreground rounded-xl font-black uppercase tracking-widest text-[10px] shadow-sm flex items-center gap-3 transition-all hover:bg-surface-elevated">
                <RefreshCw size={16} /> Export Audit
            </button>
            <button class="px-6 py-3 bg-critical hover:brightness-110 text-critical-foreground rounded-xl font-black uppercase tracking-widest text-[10px] flex items-center gap-2 shadow-xl shadow-critical/20 transition-all active:scale-95">
                <ShieldAlert size={18} /> Emergency Lockdown
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="md:col-span-1 space-y-8">
            <div class="bg-surface border border-border p-8 rounded-[2.5rem] shadow-sm space-y-8">
                <div class="flex items-center gap-5 border-b border-border pb-8">
                    <div class="w-14 h-14 bg-surface-elevated border border-border rounded-2xl flex items-center justify-center text-foreground shadow-sm">
                        <Lock size={24} />
                    </div>
                    <div>
                        <p class="text-xl font-black text-foreground uppercase tracking-tighter">System Fortress</p>
                        <p class="text-[10px] text-success font-black uppercase tracking-widest leading-none mt-1">Active & Encrypted</p>
                    </div>
                </div>
                
                <div class="space-y-3">
                    {[
                        { label: 'Cloud Encryption', status: '256-bit AES' },
                        { label: 'Role Mapping', status: 'RBAC Enforcement' },
                        { label: 'Two-Factor', status: 'Mandatory' },
                        { label: 'IP Whitelist', status: '12 Active' },
                    ].map(config => (
                        <div class="flex justify-between items-center p-5 bg-surface border border-border rounded-2xl group hover:border-primary/50 transition-all cursor-pointer">
                            <span class="text-[11px] font-black text-foreground uppercase tracking-widest">{config.label}</span>
                            <span class="text-[10px] font-black text-primary uppercase tracking-widest bg-primary/10 px-3 py-1.5 rounded-xl border border-primary/20">{config.status}</span>
                        </div>
                    ))}
                </div>
                <button class="w-full py-4 bg-surface-elevated border border-border rounded-2xl text-[10px] font-black text-foreground uppercase tracking-widest hover:bg-border transition-colors shadow-sm">
                    Modify Configuration
                </button>
            </div>

            <div class="bg-primary/5 border border-primary/20 p-10 rounded-[3rem] text-center shadow-xl relative overflow-hidden group">
                 <div class="absolute top-0 right-0 w-32 h-32 bg-primary/20 rounded-full blur-3xl -mr-16 -mt-16 group-hover:scale-150 transition-transform pointer-events-none"></div>
                 <div class="w-20 h-20 bg-success/20 rounded-full flex items-center justify-center text-success mx-auto mb-6 border-4 border-success/30 shadow-inner relative z-10">
                    <CheckCircle2 size={36} />
                 </div>
                 <h4 class="text-3xl font-black text-foreground mb-2 uppercase tracking-tighter relative z-10">Compliance: 98%</h4>
                 <p class="text-muted text-base font-medium relative z-10">Meeting ISO 27001 & SOC2 standards for data sovereignty.</p>
            </div>
        </div>

        <div class="md:col-span-2 bg-surface border border-border rounded-[3rem] overflow-hidden shadow-sm">
            <div class="p-10 border-b border-border flex justify-between items-center bg-surface-elevated">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-surface border border-border flex items-center justify-center text-foreground shadow-sm">
                       <Activity size={20} />
                    </div>
                    <h2 class="text-2xl font-black text-foreground uppercase tracking-tighter">Real-time Threat Interception</h2>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-2.5 h-2.5 rounded-full bg-critical animate-pulse shadow-[0_0_10px_#ef4444]"></div>
                    <span class="text-[10px] font-black text-critical uppercase tracking-widest">Forensic Observation Active</span>
                </div>
            </div>
            <div class="p-4 space-y-1">
                {[
                    { event: 'Unusual Login Attempt', user: 'Dublin, IE - IP: 184.21.x', time: '2m ago', severity: 'Medium' },
                    { event: 'Bulk Export Request', user: 'Finance Module - Dept ID: 412', time: '10m ago', severity: 'Low' },
                    { event: 'MFA Violation', user: 'Employee: J. Doe', time: '41m ago', severity: 'High' },
                    { event: 'API Key Created', user: 'New Node Secret - System', time: '1h ago', severity: 'Neutral' },
                    { event: 'DDoS Simulation', user: 'Internal Stress Test', time: '3h ago', severity: 'Neutral' },
                ].map(log => (
                    <div class="flex items-center gap-6 p-6 hover:bg-surface-elevated transition-all rounded-[2rem] group cursor-pointer border border-transparent hover:border-border">
                        <div class="flex items-center gap-5 flex-1 min-w-0">
                            <div class={`w-3 h-3 rounded-full shadow-sm flex-shrink-0 ${log.severity === 'High' ? 'bg-critical shadow-[0_0_8px_#ef4444]' : log.severity === 'Medium' ? 'bg-warning shadow-[0_0_8px_#f59e0b]' : log.severity === 'Low' ? 'bg-primary shadow-[0_0_8px_rgba(124,58,237,0.5)]' : 'bg-surface-elevated border border-border'}`}></div>
                            <div class="min-w-0">
                                <h4 class="text-sm font-black text-foreground uppercase tracking-tight group-hover:text-primary transition-colors truncate">{log.event}</h4>
                                <p class="text-[10px] text-muted font-black uppercase tracking-widest leading-none mt-1.5">{log.user}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-10 flex-shrink-0">
                             <div class="text-right">
                                <p class="text-[9px] font-black text-muted uppercase tracking-widest leading-none mb-1">Time Trace</p>
                                <p class="text-xs font-black text-foreground">{log.time}</p>
                             </div>
                             <div class={`px-4 py-2 rounded-xl font-black text-[10px] uppercase tracking-widest border shadow-sm ${log.severity === 'High' ? 'text-critical bg-critical/10 border-critical/20' : log.severity === 'Medium' ? 'text-warning bg-warning/10 border-warning/20' : 'text-foreground bg-surface border-border'}`}>
                                {log.severity}
                             </div>
                        </div>
                    </div>
                ))}
            </div>
            <div class="p-10 border-t border-border text-center bg-surface-elevated">
                <button class="text-primary font-black text-[10px] uppercase tracking-widest hover:brightness-110 transition-all border-b-2 border-primary/30 hover:border-primary pb-1">Download Security Forensics Report (.pdf)</button>
            </div>
        </div>
    </div>
  </div>
</DashboardLayout>
