---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { HRDashboard } from '../../components/hr/HRDashboard';
---

<DashboardLayout title="Human Resources & Talent" activeDept="HR & Training">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tighter uppercase">Talent Management</h1>
        <p class="text-[11px] font-black uppercase tracking-widest text-slate-500 mt-1">Recruitment ATS, Employee Onboarding, and AI LMS</p>
      </div>
      <div class="flex items-center gap-3">
        <button class="px-5 py-2.5 bg-violet-600 rounded-xl text-xs font-black uppercase tracking-widest text-white hover:bg-violet-500 transition-all shadow-lg shadow-violet-600/30 active:scale-95">
          Post New Job
        </button>
      </div>
    </div>

    <!-- React Island for the HR and LMS UI -->
    <HRDashboard client:load />
    
  </div>
</DashboardLayout>
