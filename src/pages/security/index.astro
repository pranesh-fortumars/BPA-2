---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { ShieldAlert, Key, Activity, RefreshCw, Lock, LayoutGrid, CheckCircle2 } from 'lucide-react';
---

<DashboardLayout title="Security & Access">
  <div class="space-y-12">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-[10px] font-black text-violet-500 uppercase tracking-widest mb-3">
               <span>Compliance</span>
               <span class="text-slate-300">/</span>
               <span class="text-slate-600">Governance</span>
            </div>
            <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter">Security Governance</h1>
            <p class="text-slate-700 font-medium mt-1">Access control, threat detection, and enterprise encryption</p>
        </div>
        <div class="flex gap-3">
            <button class="px-6 py-3 bg-white border border-slate-200 text-slate-600 rounded-xl font-black uppercase tracking-widest text-[10px] shadow-sm flex items-center gap-3 transition-all hover:bg-white">
                <RefreshCw size={16} /> Export Audit
            </button>
            <button class="px-6 py-3 bg-rose-600 hover:bg-rose-500 text-white rounded-xl font-black uppercase tracking-widest text-[10px] flex items-center gap-2 shadow-xl shadow-rose-600/20 transition-all active:scale-95">
                <ShieldAlert size={18} /> Emergency Lockdown
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="md:col-span-1 space-y-8">
            <div class="bg-white border border-slate-200 p-8 rounded-[2.5rem] shadow-sm space-y-8">
                <div class="flex items-center gap-5 border-b border-slate-50 pb-8">
                    <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-slate-900 shadow-xl shadow-slate-900/10">
                        <Lock size={24} />
                    </div>
                    <div>
                        <p class="text-xl font-black text-slate-900 uppercase tracking-tighter">System Fortress</p>
                        <p class="text-[10px] text-emerald-600 font-black uppercase tracking-widest leading-none mt-1">Active & Encrypted</p>
                    </div>
                </div>
                
                <div class="space-y-3">
                    {[
                        { label: 'Cloud Encryption', status: '256-bit AES' },
                        { label: 'Role Mapping', status: 'RBAC Enforcement' },
                        { label: 'Two-Factor', status: 'Mandatory' },
                        { label: 'IP Whitelist', status: '12 Active' },
                    ].map(config => (
                        <div class="flex justify-between items-center p-5 bg-white border border-slate-100 rounded-2xl group hover:border-violet-500/20 transition-all cursor-pointer">
                            <span class="text-[11px] font-black text-slate-700 uppercase tracking-widest">{config.label}</span>
                            <span class="text-[10px] font-black text-violet-600 uppercase tracking-widest bg-violet-50 px-3 py-1.5 rounded-xl border border-violet-100">{config.status}</span>
                        </div>
                    ))}
                </div>
                <button class="w-full py-4 bg-white border border-slate-200 rounded-2xl text-[10px] font-black text-slate-600 uppercase tracking-widest hover:bg-slate-100 transition-colors shadow-sm">
                    Modify Configuration
                </button>
            </div>

            <div class="bg-violet-600 p-10 rounded-[3rem] text-center shadow-2xl shadow-violet-600/30 relative overflow-hidden group">
                 <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-3xl -mr-16 -mt-16 group-hover:scale-150 transition-transform"></div>
                 <div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center text-slate-900 mx-auto mb-6 border-4 border-white/40 shadow-inner relative z-10">
                    <CheckCircle2 size={36} />
                 </div>
                 <h4 class="text-3xl font-black text-slate-900 mb-2 uppercase tracking-tighter relative z-10">Compliance: 98%</h4>
                 <p class="text-violet-100 text-base font-medium relative z-10">Meeting ISO 27001 & SOC2 standards for data sovereignty.</p>
            </div>
        </div>

        <div class="md:col-span-2 bg-white border border-slate-200 rounded-[3rem] overflow-hidden shadow-sm">
            <div class="p-10 border-b border-slate-100 flex justify-between items-center bg-white/50">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-slate-900 shadow-lg">
                       <Activity size={20} />
                    </div>
                    <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tighter">Real-time Threat Interception</h2>
                </div>
                <div class="flex items-center gap-3">
                    <div class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-pulse shadow-[0_0_10px_#f43f5e]"></div>
                    <span class="text-[10px] font-black text-rose-600 uppercase tracking-widest">Forensic Observation Active</span>
                </div>
            </div>
            <div class="p-4 space-y-1">
                {[
                    { event: 'Unusual Login Attempt', user: 'Dublin, IE - IP: 184.21.x', time: '2m ago', severity: 'Medium' },
                    { event: 'Bulk Export Request', user: 'Finance Module - Dept ID: 412', time: '10m ago', severity: 'Low' },
                    { event: 'MFA Violation', user: 'Employee: J. Doe', time: '41m ago', severity: 'High' },
                    { event: 'API Key Created', user: 'New Node Secret - System', time: '1h ago', severity: 'Neutral' },
                    { event: 'DDoS Simulation', user: 'Internal Stress Test', time: '3h ago', severity: 'Neutral' },
                ].map(log => (
                    <div class="flex items-center gap-6 p-6 hover:bg-white transition-all rounded-[2rem] group cursor-pointer border border-transparent hover:border-slate-100">
                        <div class="flex items-center gap-5 flex-1 min-w-0">
                            <div class={`w-3 h-3 rounded-full shadow-sm flex-shrink-0 ${log.severity === 'High' ? 'bg-rose-500 shadow-rose-500/30' : log.severity === 'Medium' ? 'bg-amber-500 shadow-amber-500/30' : log.severity === 'Low' ? 'bg-violet-500 shadow-violet-500/30' : 'bg-slate-300'}`}></div>
                            <div class="min-w-0">
                                <h4 class="text-sm font-black text-slate-900 uppercase tracking-tight group-hover:text-violet-600 transition-colors truncate">{log.event}</h4>
                                <p class="text-[10px] text-slate-600 font-black uppercase tracking-widest leading-none mt-1.5">{log.user}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-10 flex-shrink-0">
                             <div class="text-right">
                                <p class="text-[9px] font-black text-slate-600 uppercase tracking-widest leading-none mb-1">Time Trace</p>
                                <p class="text-xs font-black text-slate-600">{log.time}</p>
                             </div>
                             <div class={`px-4 py-2 rounded-xl font-black text-[10px] uppercase tracking-widest border shadow-sm ${log.severity === 'High' ? 'text-rose-600 bg-rose-50 border-rose-100' : log.severity === 'Medium' ? 'text-amber-600 bg-amber-50 border-amber-100' : 'text-slate-700 bg-white border-slate-200'}`}>
                                {log.severity}
                             </div>
                        </div>
                    </div>
                ))}
            </div>
            <div class="p-10 border-t border-slate-50 text-center bg-white/20">
                <button class="text-violet-600 font-black text-[10px] uppercase tracking-widest hover:text-violet-800 transition-all border-b-2 border-violet-100 hover:border-violet-600 pb-1">Download Security Forensics Report (.pdf)</button>
            </div>
        </div>
    </div>
  </div>
</DashboardLayout>






