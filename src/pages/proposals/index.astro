---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { ProposalManager } from '../../components/commercial/ProposalManager';
---

<DashboardLayout title="Proposals | BPA PRO" activeDept="Commercial">
  <div class="mb-8">
    <h1 class="text-3xl font-black text-foreground tracking-tight mb-2">Commercial <span class="text-primary">Proposals</span></h1>
    <p class="text-muted font-medium">Generate, track, and manage sales proposals.</p>
  </div>
  
  <ProposalManager client:load />
</DashboardLayout>
