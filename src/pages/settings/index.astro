---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { 
  Settings, 
  Bell, 
  Database, 
  Cloud, 
  Globe, 
  Code2, 
  ShieldCheck, 
  Cpu, 
  Activity, 
  MousePointer2,
  Save,
  Trash2,
  Plus
} from 'lucide-react';
---

<DashboardLayout title="System Settings">
  <div class="space-y-12">
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-10 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-[10px] font-black text-violet-500 uppercase tracking-widest mb-3">
               <span>Infrastructure</span>
               <span class="text-slate-300">/</span>
               <span class="text-slate-600">Environment</span>
            </div>
            <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter">System Configuration</h1>
            <p class="text-slate-700 font-medium mt-1">Configure core node infrastructure, global variables, and automation protocols</p>
        </div>
        <button class="px-8 py-4 bg-violet-600 hover:bg-violet-500 text-white rounded-2xl font-black flex items-center gap-3 shadow-xl shadow-violet-600/20 transition-all uppercase tracking-widest text-xs active:scale-95">
            <Save size={18} /> Apply Global Node Changes
        </button>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-4 gap-12">
        <aside class="xl:col-span-1 space-y-3">
            {[
                { label: 'General Protocol', icon: Globe, active: true },
                { label: 'Cloud Infrastructure', icon: Cloud, active: false },
                { label: 'Automation Engine', icon: Cpu, active: false },
                { label: 'Data Sovereignty', icon: ShieldCheck, active: false },
                { label: 'Alerting & SIEM', icon: Bell, active: false },
                { label: 'Developer SDK', icon: Code2, active: false },
            ].map(item => (
                <div class={`flex items-center gap-5 px-8 py-5 rounded-[2rem] cursor-pointer transition-all border shadow-sm ${item.active ? 'bg-violet-600 border-violet-500 text-white shadow-xl shadow-violet-600/20 active:scale-95' : 'bg-white border-slate-200 text-slate-600 hover:bg-white hover:text-slate-900 hover:border-violet-500/20'}`}>
                    <item.icon size={22} class={item.active ? 'text-slate-900' : ''} />
                    <span class="text-[11px] font-black uppercase tracking-widest">{item.label}</span>
                </div>
            ))}
        </aside>

        <section class="xl:col-span-3 space-y-10">
            <div class="bg-white border border-slate-200 rounded-[3rem] p-12 space-y-12 shadow-sm">
                 <div class="flex items-center gap-6 border-b border-slate-50 pb-12">
                    <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-slate-900 shadow-xl shadow-slate-900/10">
                        <Globe size={32} />
                    </div>
                    <div>
                        <h3 class="text-2xl font-black text-slate-900 uppercase tracking-tighter">Global Protocol Environment</h3>
                        <p class="text-slate-700 text-sm font-medium">Standardize the core operating environment for all localized BPA units.</p>
                    </div>
                 </div>

                 <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                    <div class="space-y-4">
                        <label class="text-[10px] font-black text-slate-600 uppercase tracking-widest pl-2">System Broadcast Title</label>
                        <input type="text" value="BPA PREVIEW v2.0" class="w-full bg-white border border-slate-200 rounded-2xl px-6 py-4 text-slate-900 font-black text-sm focus:outline-none focus:border-violet-500 focus:bg-white transition-all font-mono uppercase tracking-tight shadow-inner" />
                    </div>
                    <div class="space-y-4">
                        <label class="text-[10px] font-black text-slate-600 uppercase tracking-widest pl-2">Primary Node Region</label>
                        <div class="relative group">
                            <select class="w-full bg-white border border-slate-200 rounded-2xl px-6 py-4 text-slate-900 font-black text-sm focus:outline-none focus:border-violet-500 focus:bg-white transition-all appearance-none cursor-pointer uppercase tracking-tight shadow-inner">
                                <option>North America (East-1)</option>
                                <option>Europe (Frankfurt)</option>
                                <option>Asia (Mumbai)</option>
                            </select>
                            <MousePointer2 class="absolute right-6 top-1/2 -translate-y-1/2 text-slate-300 pointer-events-none group-hover:text-slate-900 transition-colors" size={18} />
                        </div>
                    </div>
                 </div>

                 <div class="space-y-4 pt-12 border-t border-slate-50">
                    <h4 class="text-[10px] font-black text-slate-600 uppercase tracking-widest pl-2 mb-6">Security & Synchronization</h4>
                    <div class="flex justify-between items-center bg-white p-8 rounded-3xl border border-slate-200 shadow-sm hover:shadow-md transition-all group">
                        <div class="flex items-center gap-6">
                            <div class="w-14 h-14 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-600 border border-emerald-100 group-hover:scale-110 transition-transform">
                                <Database size={24} />
                            </div>
                            <div>
                                <h4 class="text-sm font-black text-slate-900 uppercase tracking-tight">Auto-Sync Data Lake</h4>
                                <p class="text-[10px] text-slate-600 font-black uppercase tracking-widest leading-none mt-1.5">Synchronize workflow state across global nodes every 120ms.</p>
                            </div>
                        </div>
                        <div class="w-14 h-8 bg-violet-600 rounded-full relative cursor-pointer shadow-lg shadow-violet-600/20 transition-all">
                             <div class="w-6 h-6 bg-white rounded-full absolute top-1 right-1 shadow-sm"></div>
                        </div>
                    </div>

                    <div class="flex justify-between items-center bg-white p-8 rounded-3xl border border-slate-200 shadow-sm hover:shadow-md transition-all group">
                        <div class="flex items-center gap-6">
                            <div class="w-14 h-14 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-600 border border-amber-100 group-hover:scale-110 transition-transform">
                                <ShieldCheck size={24} />
                            </div>
                            <div>
                                <h4 class="text-sm font-black text-slate-900 uppercase tracking-tight">Heavy Encryption Mode</h4>
                                <p class="text-[10px] text-slate-600 font-black uppercase tracking-widest leading-none mt-1.5">Activate 4096-bit AES encryption for all cross-talk.</p>
                            </div>
                        </div>
                        <div class="w-14 h-8 bg-slate-100 rounded-full relative cursor-pointer transition-all border border-slate-300">
                             <div class="w-6 h-6 bg-white rounded-full absolute top-1 left-1 shadow-sm"></div>
                        </div>
                    </div>
                 </div>

                 <div class="pt-12 flex flex-col md:flex-row justify-between items-center gap-6">
                    <button class="flex items-center gap-3 px-8 py-4 bg-rose-50 text-rose-600 border border-rose-100 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-rose-600 hover:text-white transition-all shadow-sm active:scale-95">
                        <Trash2 size={18} />
                        Purge Transient Data
                    </button>
                    <div class="flex gap-4">
                        <button class="px-8 py-4 bg-white text-slate-600 rounded-2xl font-black uppercase tracking-widest text-[10px] border border-slate-200 hover:text-slate-900 hover:bg-white transition-all shadow-sm">Reset Defaults</button>
                        <button class="px-8 py-4 bg-white text-slate-900 rounded-2xl font-black uppercase tracking-widest text-[10px] shadow-xl shadow-slate-900/10 hover:bg-black transition-all active:scale-95">Download Backup (.bsf)</button>
                    </div>
                 </div>
            </div>
        </section>
    </div>
  </div>
</DashboardLayout>






