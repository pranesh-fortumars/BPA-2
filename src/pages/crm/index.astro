---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { CRMDashboard } from '../../components/crm/CRMDashboard';
---

<DashboardLayout title="Client Lifecycle Management" activeDept="Sales & CRM">
  <div class="space-y-8 font-sans">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-black text-foreground tracking-tighter uppercase">CRM & Lead Pipeline</h1>
        <p class="text-[11px] font-black uppercase tracking-widest text-muted mt-1">AI-Powered Lead Scoring & Sales Automation</p>
      </div>
      <div class="flex items-center gap-3">
        <button class="px-5 py-2.5 bg-surface border border-border rounded-xl text-xs font-black uppercase tracking-widest text-muted hover:text-foreground hover:bg-surface-elevated transition-all shadow-sm active:scale-95">
          Import Leads
        </button>
        <button class="px-5 py-2.5 bg-primary rounded-xl text-xs font-black uppercase tracking-widest text-primary-foreground hover:brightness-110 transition-all shadow-lg shadow-primary/30 active:scale-95">
          Quotation Builder
        </button>
      </div>
    </div>

    <!-- React Island for the CRM components -->
    <CRMDashboard client:load />
    
  </div>
</DashboardLayout>
