---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { 
  Briefcase, 
  Layers, 
  ArrowUpRight, 
  ArrowDownRight, 
  Zap, 
  BarChart3, 
  Users, 
  Clock, 
  Plus,
  MoreHorizontal
} from 'lucide-react';
---

<DashboardLayout title="Departmental Overview">
  <div class="space-y-12">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-10 pb-2 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-2 text-[10px] font-black text-violet-500 uppercase tracking-widest mb-3">
               <span>Organization</span>
               <span class="text-slate-300">/</span>
               <span class="text-slate-600">Departmental Analytics</span>
            </div>
            <h1 class="text-4xl font-black text-slate-900 uppercase tracking-tighter">Departmental Analytics</h1>
            <p class="text-slate-700 font-medium mt-1">Global performance benchmarks and cross-functional task velocity</p>
        </div>
        <button class="px-8 py-4 bg-violet-600 hover:bg-violet-500 text-white rounded-2xl font-black flex items-center gap-3 shadow-xl shadow-violet-600/20 transition-all uppercase tracking-widest text-xs active:scale-95">
            <Plus size={18} /> New Operational Business Unit
        </button>
    </div>

    <!-- Cluster Performance -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        {[
            { name: 'Engineering', lead: 'Praneeth K.', efficiency: 94, trend: +2.4, color: 'text-blue-600', bg: 'bg-blue-50', border: 'border-blue-100' },
            { name: 'Human Resources', lead: 'Sarah J.', efficiency: 88, trend: +1.8, color: 'text-violet-600', bg: 'bg-violet-50', border: 'border-violet-100' },
            { name: 'Finance Control', lead: 'Michael R.', efficiency: 92, trend: -0.5, color: 'text-emerald-600', bg: 'bg-emerald-50', border: 'border-emerald-100' }
        ].map(dept => (
            <div class="bg-white border border-slate-200 p-8 rounded-[3rem] relative overflow-hidden group hover:shadow-2xl transition-all shadow-sm">
                <div class={`absolute top-0 right-0 w-32 h-32 ${dept.bg} rounded-bl-full -mr-16 -mt-16 blur-2xl group-hover:scale-150 transition-transform`}></div>
                
                <div class="flex justify-between items-start mb-10 relative">
                    <div class={`p-4 rounded-2xl ${dept.bg} border border-white shadow-sm group-hover:scale-110 transition-transform`}>
                        <Briefcase class={dept.color} size={28} />
                    </div>
                    <div class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl border ${dept.trend >= 0 ? 'text-emerald-600 bg-emerald-50 border-emerald-100' : 'text-rose-600 bg-rose-50 border-rose-100'} text-[10px] font-black uppercase tracking-widest shadow-sm`}>
                        {dept.trend >= 0 ? <ArrowUpRight size={14} /> : <ArrowDownRight size={14} />}
                        {Math.abs(dept.trend)}%
                    </div>
                </div>

                <div class="relative">
                    <h3 class="text-2xl font-black text-slate-900 uppercase tracking-tighter mb-1 mt-4">{dept.name}</h3>
                    <p class="text-slate-600 text-[10px] font-black uppercase tracking-widest mb-10">Lead: {dept.lead}</p>
                    
                    <div class="space-y-3">
                        <div class="flex justify-between items-end">
                            <span class="text-[10px] font-black text-slate-600 uppercase tracking-widest">Automation Efficiency</span>
                            <span class={`text-xl font-black ${dept.color} tracking-tighter leading-none`}>{dept.efficiency}%</span>
                        </div>
                        <div class="h-1.5 w-full bg-white border border-slate-100 rounded-full overflow-hidden shadow-inner">
                            <div class={`h-full ${dept.bg.replace('50', '500')} rounded-full shadow-[0_0_10px_rgba(255,255,255,0.1)]`} style={{ width: `${dept.efficiency}%` }}></div>
                        </div>
                    </div>
                </div>

                <div class="mt-12 grid grid-cols-2 gap-4 relative">
                    <button class="py-3.5 bg-white border border-slate-200 rounded-2xl text-[10px] font-black text-slate-700 uppercase tracking-widest hover:text-slate-900 hover:bg-white transition-all shadow-sm active:scale-95">
                        View Resources
                    </button>
                    <button class="py-3.5 bg-white border border-slate-100 rounded-2xl text-[10px] font-black text-slate-900 uppercase tracking-widest hover:bg-black transition-all shadow-xl shadow-slate-900/10 active:scale-95">
                        Efficiency Log
                    </button>
                </div>
            </div>
        ))}
    </div>

    <!-- Comparative Table -->
    <div class="bg-white border border-slate-200 rounded-[3rem] overflow-hidden shadow-sm">
        <div class="p-10 border-b border-slate-100 flex flex-col md:flex-row justify-between items-center bg-white/50 gap-6">
            <div>
                <h2 class="text-3xl font-black text-slate-900 uppercase tracking-tighter flex items-center gap-4">
                    <div class="p-2.5 rounded-xl bg-white text-slate-900">
                        <Layers size={22} />
                    </div>
                    BPA Performance Matrix
                </h2>
                <p class="text-slate-700 text-[11px] mt-2 font-black uppercase tracking-widest">Comparative analysis of task volume and node processing speed</p>
            </div>
            <div class="flex gap-3">
                <button class="p-4 bg-white border border-slate-200 rounded-2xl text-slate-600 hover:text-slate-900 transition-all shadow-sm active:scale-95">
                    <BarChart3 size={20} />
                </button>
                <button class="p-4 bg-white border border-slate-200 rounded-2xl text-slate-600 hover:text-slate-900 transition-all shadow-sm active:scale-95">
                    <MoreHorizontal size={20} />
                </button>
            </div>
        </div>
        <div class="w-full overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-white/20 text-[10px] font-black text-slate-600 uppercase tracking-widest border-b border-slate-50">
                        <th class="px-12 py-8">Operational Node</th>
                        <th class="px-12 py-8">Active Tasks</th>
                        <th class="px-12 py-8">Success Rate</th>
                        <th class="px-12 py-8">Avg Latency</th>
                        <th class="px-12 py-8 text-right">Infrastructure Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    {[
                        { name: 'Core Operations', tasks: 412, success: 99.8, latency: '40ms', health: 'Optimal' },
                        { name: 'Financial Hub', tasks: 184, success: 100, latency: '12ms', health: 'Critical Node' },
                        { name: 'HR Data Relay', tasks: 92, success: 98.4, latency: '120ms', health: 'Stable' },
                        { name: 'Sales Pipeline', tasks: 312, success: 97.2, latency: '85ms', health: 'Stable' },
                        { name: 'Support Tickets', tasks: 521, success: 99.1, latency: '210ms', health: 'High Load' }
                    ].map((row, i) => (
                        <tr class="hover:bg-white transition-all cursor-pointer group">
                            <td class="px-12 py-8">
                                <div class="flex items-center gap-4">
                                    <div class="w-2 h-2 rounded-full bg-violet-600 shadow-[0_0_8px_#4f46e5] group-hover:scale-150 transition-transform"></div>
                                    <span class="text-base font-black text-slate-900 uppercase tracking-tight group-hover:text-violet-600 transition-colors">{row.name}</span>
                                </div>
                            </td>
                            <td class="px-12 py-8 text-slate-600 font-black uppercase tracking-widest text-xs italic">{row.tasks} units</td>
                            <td class="px-12 py-8">
                                <div class="flex items-center gap-2">
                                    <div class={`w-2 h-2 rounded-full ${row.success > 99 ? 'bg-emerald-500 shadow-[0_0_8px_#10b981]' : 'bg-amber-400 shadow-[0_0_8px_#fbbf24]'}`}></div>
                                    <span class="text-[11px] font-black text-slate-600 uppercase tracking-tight">{row.success}% Accuracy</span>
                                </div>
                            </td>
                            <td class="px-12 py-8 text-violet-600 font-black text-xs uppercase tracking-tight leading-none italic">{row.latency} Response</td>
                            <td class="px-12 py-8 text-right">
                                <div class={`px-5 py-2 rounded-xl font-black text-[9px] inline-block border transition-all uppercase tracking-widest shadow-sm ${row.health === 'Critical Node' ? 'bg-rose-50 border-rose-100 text-rose-600' : row.health === 'Optimal' ? 'bg-emerald-50 border-emerald-100 text-emerald-600 shadow-emerald-500/10' : 'bg-white border-slate-200 text-slate-700'}`}>
                                    {row.health}
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
  </div>
</DashboardLayout>






