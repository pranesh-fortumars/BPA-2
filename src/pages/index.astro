---
import MainLayout from '../layouts/MainLayout.astro';
import { 
  Zap, 
  Workflow, 
  Target, 
  ShieldCheck, 
  TrendingUp, 
  ChevronRight,
  ArrowRight,
  BrainCircuit,
  Bot
} from 'lucide-react';
---

<MainLayout title="BPA PRO | Enterprise Process Orchestration">
  <!-- Dynamic Background Elements -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10 bg-white">
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-violet-600/5 blur-[120px] rounded-full animate-pulse"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-600/5 blur-[120px] rounded-full animate-pulse-slow"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
  </div>

  <!-- Navbar -->
  <header class="fixed top-0 left-0 w-full z-50 px-8 py-6 flex items-center justify-between backdrop-blur-xl border-b border-slate-200/50 bg-white/70">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 bg-violet-600 rounded-2xl flex items-center justify-center shadow-xl shadow-violet-600/20">
        <Zap size={28} className="text-slate-900 fill-current" />
      </div>
      <span class="font-black text-3xl tracking-tighter text-slate-900 uppercase">BPA <span class="text-violet-600">PRO</span></span>
    </div>
    
    <nav class="hidden lg:flex items-center gap-10">
      {['Features', 'Solutions', 'Infrastructure', 'Enterprise'].map(item => (
        <a href={`#${item.toLowerCase()}`} class="text-[10px] font-black text-slate-600 hover:text-slate-900 uppercase tracking-widest transition-all">{item}</a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a href="/login" class="text-[10px] font-black text-slate-700 hover:text-slate-900 px-6 uppercase tracking-widest">Log in</a>
      <a href="/dashboard" class="px-8 py-3.5 bg-violet-600 hover:bg-violet-500 text-white rounded-[2rem] text-[10px] font-black uppercase tracking-widest shadow-2xl shadow-violet-600/20 transition-all hover:translate-y-[-2px] active:scale-95">
        Launch Platform
      </a>
    </div>
  </header>

  <main class="relative pt-48 pb-20 overflow-x-hidden">
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-8 relative">
      <div class="text-center max-w-5xl mx-auto mb-32">
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-2xl bg-white border border-slate-200 text-violet-600 shadow-sm text-[10px] font-black mb-10 uppercase tracking-widest animate-bounce-slow">
           <div class="w-2 h-2 rounded-full bg-violet-600 animate-pulse"></div>
           2026 Enterprise Edition
        </div>
        <h1 class="text-7xl md:text-9xl font-black text-slate-900 leading-[0.85] tracking-tighter mb-10 uppercase">
          Orchestrate <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 via-blue-600 to-violet-900">Velocity</span>
        </h1>
        <p class="text-2xl text-slate-700 leading-relaxed max-w-3xl mx-auto mb-16 font-medium">
          The unified intelligence engine for modern global operations. Automate multi-step corporate workflows with AI-driven optimization and sub-second observability.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <a href="/dashboard" class="w-full sm:w-auto px-12 py-5 bg-white hover:bg-black text-white rounded-[2.5rem] text-xs font-black uppercase tracking-widest shadow-2xl shadow-slate-900/20 transition-all flex items-center justify-center gap-4 active:scale-95">
             Start Free Protocol <ArrowRight size={20} />
          </a>
          <button class="w-full sm:w-auto px-12 py-5 bg-white hover:bg-white text-slate-900 border border-slate-200 rounded-[2.5rem] text-xs font-black uppercase tracking-widest transition-all flex items-center justify-center gap-4 shadow-sm active:scale-95">
             Watch Neural Demo
          </button>
        </div>
      </div>

      <!-- Hero Logic Visual (CSS Based) -->
      <div class="mt-24 relative group max-w-6xl mx-auto">
        <div class="absolute inset-0 bg-violet-600/5 blur-[120px] rounded-full scale-90 group-hover:scale-100 transition-transform duration-1000"></div>
        <div class="relative rounded-[4rem] border border-slate-200 bg-white/80 backdrop-blur-3xl overflow-hidden shadow-2xl p-16 lg:p-24 group-hover:shadow-[0_0_100px_rgba(79,70,229,0.1)] transition-all">
           <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
              <div class="space-y-10">
                 <div class="inline-flex items-center gap-3 px-5 py-2 rounded-xl bg-white border border-slate-100 text-slate-600 text-[10px] font-black uppercase tracking-widest">
                    <ShieldCheck size={16} class="text-violet-600" /> Infrastructure Consensus Active
                 </div>
                 <h2 class="text-5xl font-black text-slate-900 uppercase tracking-tighter leading-[0.9]">Sub-second <br/> Neural Trust.</h2>
                 <p class="text-slate-700 text-xl font-medium leading-relaxed">Our protocol engine handles complex multi-layer approval chains with 99.98% audit purity across 40+ global nodes.</p>
                 <div class="grid grid-cols-2 gap-4">
                    {[1, 2, 3, 4].map(i => (
                        <div class="p-6 rounded-3xl bg-white border border-slate-100 flex flex-col gap-3 group/stat hover:bg-white hover:border-violet-500/20 transition-all">
                           <div class="h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
                              <div class="h-full bg-violet-600 shadow-[0_0_8px_#4f46e5]" style={{ width: `${60 + i * 10}%` }}></div>
                           </div>
                           <span class="text-[9px] font-black text-slate-600 uppercase tracking-widest group-hover/stat:text-violet-600 transition-colors">Neural Sector {i}</span>
                        </div>
                    ))}
                 </div>
              </div>
              <div class="relative">
                 <div class="w-full aspect-square md:aspect-video rounded-[3rem] bg-white shadow-2xl relative overflow-hidden group">
                    <div class="absolute inset-0 flex items-center justify-center opacity-20">
                        <div class="w-64 h-64 bg-violet-500 rounded-full blur-[100px] animate-pulse"></div>
                    </div>
                    <div class="absolute inset-0 p-12 flex flex-col justify-between">
                       <div class="space-y-6">
                          <div class="h-2 bg-white/10 w-full rounded-full"></div>
                          <div class="h-2 bg-white/10 w-2/3 rounded-full"></div>
                          <div class="h-2 bg-violet-500/40 w-3/4 rounded-full shadow-[0_0_15px_#6366f1]"></div>
                       </div>
                       <div class="flex justify-between items-end">
                          <div class="w-16 h-16 bg-white/10 border border-white/20 rounded-2xl flex items-center justify-center backdrop-blur-md">
                             <BrainCircuit size={36} className="text-slate-900" />
                          </div>
                          <div class="text-right">
                             <p class="text-slate-900 font-black text-3xl uppercase tracking-tighter">BPA CORE v4</p>
                             <p class="text-violet-400 text-[10px] font-black uppercase tracking-widest mt-1">Sovereign Cluster Active</p>
                          </div>
                       </div>
                    </div>
                 </div>
              </div>
           </div>
        </div>
      </div>
    </section>

    <!-- Logo Cloud -->
    <section class="py-32 border-y border-slate-100 mt-32 bg-white">
       <div class="max-w-7xl mx-auto px-8">
          <p class="text-center text-slate-600 text-[10px] font-black uppercase tracking-widest mb-16 px-6 py-2 bg-white border border-slate-200 rounded-full inline-block left-1/2 -translate-x-1/2 relative">Trusted by the Global Fortune 500</p>
          <div class="flex flex-wrap justify-center gap-16 lg:gap-32 opacity-40 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-700">
             <div class="font-black text-3xl text-slate-900 tracking-tighter uppercase">SAPPHIRE</div>
             <div class="font-black text-3xl text-slate-900 tracking-tighter uppercase">NEXUS</div>
             <div class="font-black text-3xl text-slate-900 tracking-tighter uppercase">HORIZON</div>
             <div class="font-black text-3xl text-slate-900 tracking-tighter uppercase">EQUINOX</div>
             <div class="font-black text-3xl text-slate-900 tracking-tighter uppercase">VELOCITY</div>
          </div>
       </div>
    </section>

    <!-- Features Bento -->
    <section id="features" class="py-40 max-w-7xl mx-auto px-8">
       <div class="mb-24">
          <div class="w-12 h-1.5 bg-violet-600 rounded-full mb-8 shadow-[0_0_10px_#4f46e5]"></div>
          <h2 class="text-6xl md:text-7xl font-black text-slate-900 leading-[0.9] mb-6 uppercase tracking-tighter">Architected for <br/> Global <span class="text-violet-600">Scale</span>.</h2>
          <p class="text-slate-700 max-w-2xl text-xl font-medium">Every module is hardened to handle thousands of concurrent transactions with sub-second latency across cross-functional departments.</p>
       </div>

       <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <!-- Card 1 -->
          <div class="p-10 rounded-[3rem] bg-white border border-slate-200 hover:border-violet-600/30 transition-all group shadow-sm hover:shadow-2xl">
             <div class="w-16 h-16 rounded-2xl bg-white flex items-center justify-center text-slate-900 mb-8 group-hover:scale-110 transition-transform shadow-xl shadow-slate-900/10">
                <Workflow size={28} />
             </div>
             <h3 class="text-2xl font-black text-slate-900 mb-4 uppercase tracking-tighter">Visual Orchestrator</h3>
             <p class="text-slate-700 text-base font-medium leading-relaxed mb-8">No-code drag-and-drop orchestration that allows operations leaders to deploy complex logic without engineering support.</p>
             <a href="#" class="text-violet-600 text-xs font-black uppercase tracking-widest flex items-center gap-2 group-hover:gap-4 transition-all">Learn more <ChevronRight size={18} /></a>
          </div>

          <!-- Card 2 -->
          <div class="md:col-span-2 p-10 rounded-[3rem] bg-white border border-slate-200 hover:border-blue-600/30 transition-all group overflow-hidden relative shadow-sm hover:shadow-2xl">
             <div class="relative z-10 flex flex-col lg:flex-row gap-12 items-center h-full">
                <div class="flex-1">
                   <div class="w-16 h-16 rounded-2xl bg-violet-600 flex items-center justify-center text-white mb-8 group-hover:scale-110 transition-transform shadow-xl shadow-violet-600/10">
                      <Target size={28} />
                   </div>
                   <h3 class="text-3xl font-black text-slate-900 mb-4 uppercase tracking-tighter">Neural Decisions</h3>
                   <p class="text-slate-700 text-lg font-medium leading-relaxed mb-10 max-w-sm">Our proprietary intelligence layer identifies bottlenecks and suggests optimized routing paths in real-time using deep data mining.</p>
                   <div class="flex gap-4">
                      <div class="px-5 py-2 rounded-xl bg-white border border-slate-200 text-violet-600 text-[10px] font-black uppercase tracking-widest shadow-sm">LLM Enhanced</div>
                      <div class="px-5 py-2 rounded-xl bg-white border border-slate-200 text-blue-600 text-[10px] font-black uppercase tracking-widest shadow-sm">Predictive Flow</div>
                   </div>
                </div>
                <div class="flex-1 w-full bg-white rounded-[2rem] border border-slate-200 p-8 shadow-inner relative h-80 lg:h-full group-hover:scale-[1.02] transition-transform">
                    {/* Simulated Graph/Logic */}
                    <div class="h-full flex flex-col justify-between p-4">
                        <div class="space-y-4">
                           <div class="h-3 bg-white w-full rounded-full animate-pulse"></div>
                           <div class="h-3 bg-violet-100 w-3/4 rounded-full"></div>
                        </div>
                        <div class="flex items-center gap-6">
                           <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-slate-900">
                              <Zap size={24} />
                           </div>
                           <div class="h-3 bg-white w-1/2 rounded-full"></div>
                        </div>
                        <div class="h-3 bg-white w-2/3 rounded-full self-end"></div>
                    </div>
                </div>
             </div>
          </div>
       </div>
    </section>

    <!-- Bottom CTA -->
    <section class="max-w-7xl mx-auto px-8 py-40">
       <div class="p-20 md:p-32 rounded-[5rem] bg-violet-600 relative overflow-hidden shadow-2xl shadow-violet-600/30 text-center">
          <div class="absolute top-0 right-0 p-12 opacity-10">
             <Bot size={240} className="text-slate-900" />
          </div>
          <h2 class="text-6xl md:text-8xl font-black text-slate-900 mb-12 relative z-10 tracking-[ -0.05em] uppercase leading-[0.85]">
            Ready to <br/> scale your <br/> culture?
          </h2>
          <div class="flex flex-col sm:flex-row justify-center gap-6 relative z-10">
             <button class="px-14 py-6 bg-white text-violet-600 rounded-[2.5rem] font-black text-xs uppercase tracking-widest hover:scale-105 transition-all shadow-2xl active:scale-95">
                Contact Global Sales
             </button>
             <button class="px-14 py-6 bg-white text-slate-900 rounded-[2.5rem] font-black text-xs uppercase tracking-widest hover:bg-black transition-all shadow-2xl active:scale-95">
                Request Protocol Access
             </button>
          </div>
          <p class="text-violet-200 mt-12 font-black uppercase tracking-widest text-xs">Join 500+ enterprises optimizing with BPA PRO.</p>
       </div>
    </section>
  </main>

  <footer class="py-32 border-t border-slate-200 bg-white">
     <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-4 gap-20">
        <div class="md:col-span-1">
           <div class="flex items-center gap-3 mb-10">
              <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-xl shadow-slate-900/10">
                <Zap size={24} className="text-slate-900 fill-current" />
              </div>
              <span class="font-black text-2xl text-slate-900 uppercase tracking-tighter">BPA <span class="text-violet-600">PRO</span></span>
           </div>
           <p class="text-slate-600 text-xs font-black uppercase tracking-widest leading-loose mb-10">The operating system for the modern organization. Efficiency as a service.</p>
        </div>
        {[
          { title: 'Protocol', links: ['Features', 'Integrations', 'Enterprise', 'Security'] },
          { title: 'Infrastructure', links: ['Documentation', 'API Reference', 'Network Status', 'Forensics'] },
          { title: 'Governance', links: ['Sovereignty', 'Compliance', 'Privacy', 'Legal'] }
        ].map(section => (
          <div>
             <h4 class="text-slate-900 font-black text-[10px] uppercase tracking-widest mb-10">{section.title}</h4>
             <nav class="flex flex-col gap-5 text-[10px] font-black text-slate-600 uppercase tracking-widest">
                {section.links.map(link => (
                  <a href="#" class="hover:text-violet-600 transition-colors">{link}</a>
                ))}
             </nav>
          </div>
        ))}
     </div>
     <div class="max-w-7xl mx-auto px-8 mt-32 pt-12 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-8">
        <p class="text-slate-600 text-[9px] font-black uppercase tracking-widest">© 2026 BPA Intelligence Systems, Inc. All rights reserved.</p>
        <div class="flex gap-10 text-[9px] font-black uppercase tracking-widest text-slate-600">
           {['X / Twitter', 'LinkedIn', 'Terminal'].map(social => (
             <a href="#" class="hover:text-slate-900 transition-colors uppercase">{social}</a>
           ))}
        </div>
     </div>
  </footer>
</MainLayout>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 0.1; }
    50% { opacity: 0.3; }
  }
  .animate-pulse-slow {
    animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes bounce-slow {
     0%, 100% { transform: translateY(0); }
     50% { transform: translateY(-5px); }
  }
  .animate-bounce-slow {
     animation: bounce-slow 3s infinite;
  }
</style>






