---
import MainLayout from './MainLayout.astro';
import { Sidebar } from '../components/Sidebar';
import { Search, Bell, MessageSquare, HelpCircle, User, Calendar, Settings } from 'lucide-react';
import { MockLoginOverlay } from '../components/auth/MockLoginOverlay';
import { TopbarUser } from '../components/auth/TopbarUser';
import { MockInit } from '../components/MockInit';

interface Props {
  title?: string;
  activeDept?: string;
}

const { title, activeDept } = Astro.props;
const currentPath = Astro.url.pathname;
---

<MainLayout title={title}>
  <div class="flex min-h-screen bg-background text-foreground font-sans">
    <MockLoginOverlay client:only="react" />
    <MockInit client:only="react" />
    <Sidebar client:load currentPath={currentPath} />
    
    <div class="flex-1 transition-all duration-300 ml-[280px] bg-background min-h-screen flex flex-col">
      <!-- Topbar -->
      <header class="h-16 flex items-center justify-between px-8 bg-surface border-b border-border sticky top-0 z-40">
        <!-- Left: Search Hub -->
        <div class="flex-1 flex items-center gap-6">
           <div class="hidden lg:flex items-center px-4 py-2 bg-background border border-border rounded-lg focus-within:border-primary/50 focus-within:ring-1 focus-within:ring-primary/20 transition-all w-80 group">
             <Search className="text-muted w-4 h-4 mr-3 group-focus-within:text-primary transition-colors" />
             <input 
               type="text" 
               placeholder="Search anything..." 
               class="bg-transparent border-none focus:outline-none text-sm text-foreground placeholder-muted w-full"
             />
             <div class="flex items-center gap-1 opacity-50">
                <kbd class="px-1.5 py-0.5 text-[10px] font-medium text-foreground bg-surface-elevated rounded border border-border">⌘K</kbd>
             </div>
           </div>
        </div>
        
        <!-- Right: Actions & User -->
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2 mr-2">
             <button class="w-9 h-9 rounded-full hover:bg-surface-elevated flex items-center justify-center text-muted hover:text-foreground transition-colors relative">
                <HelpCircle size={18} />
             </button>
             <button class="w-9 h-9 rounded-full hover:bg-surface-elevated flex items-center justify-center text-muted hover:text-foreground transition-colors relative">
                <Bell size={18} />
                <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-critical border-2 border-surface"></span>
             </button>
          </div>
          
          <TopbarUser client:load />
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 p-8 max-w-[1600px] w-full mx-auto">
        <slot />
      </main>

      <!-- System Status Footer -->
      <footer class="h-12 border-t border-border bg-surface px-8 flex items-center justify-between text-[11px] font-medium text-muted">
         <div class="flex items-center gap-6">
            <div class="flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-success opacity-80 animate-pulse"></span>
               System Status: <span class="text-success border border-success/20 bg-success/10 px-2 py-0.5 rounded-full ml-1">All Systems Operational</span>
            </div>
            <div class="flex items-center gap-2">
               <span class="opacity-70">Environment:</span>
               <span class="text-info border border-info/20 bg-info/10 px-2 py-0.5 rounded-full">Production</span>
            </div>
            <div class="flex items-center gap-2">
               <span class="opacity-70">Active Bots:</span>
               <span class="text-primary border border-primary/20 bg-primary/10 px-2 py-0.5 rounded-full">38 / 50</span>
            </div>
            <div class="flex items-center gap-2">
               <span class="opacity-70">AI Agents:</span>
               <span class="text-primary border border-primary/20 bg-primary/10 px-2 py-0.5 rounded-full">24</span>
            </div>
         </div>
         <div class="flex items-center gap-6">
            <div class="flex items-center gap-2">
               <Calendar size={14} className="opacity-50" />
               <span class="opacity-70">Upcoming Maintenance:</span>
               <span class="text-foreground">24 Aug 2026, 02:00 AM IST</span>
            </div>
            <span>&copy; 2026 BPA Pro. All rights reserved.</span>
         </div>
      </footer>
    </div>
  </div>
</MainLayout>

<style>
  div :global(.ml-\[88px\]-sidebar) {
     margin-left: 88px;
  }
</style>






