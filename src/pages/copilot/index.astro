---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { Bot } from 'lucide-react';
---

<DashboardLayout title="AI Copilot">
  <div class="space-y-6">
    <div class="flex items-end justify-between gap-6 pb-2">
      <div>
        <h1 class="text-3xl font-bold text-foreground tracking-tight">AI Copilot</h1>
        <p class="text-sm text-muted mt-1">Chat with your enterprise data and generate automation workflows</p>
      </div>
    </div>
    
    <div class="bg-surface border border-border rounded-xl p-16 flex flex-col items-center justify-center text-center">
      <div class="w-20 h-20 bg-primary/10 text-primary rounded-3xl flex items-center justify-center mb-6">
        <Bot size={40} />
      </div>
      <h2 class="text-2xl font-bold text-foreground mb-3 tracking-tight">AI Copilot Coming Soon</h2>
      <p class="text-muted max-w-md mx-auto leading-relaxed">The next-generation enterprise LLM assistant is currently training on domain data. This module will be available in an upcoming release.</p>
    </div>
  </div>
</DashboardLayout>
