---
import MainLayout from '../layouts/MainLayout.astro';
import { Zap, ShieldCheck, Mail, Lock, ArrowRight, Github, Chrome } from 'lucide-react';
---

<MainLayout title="Log in | BPA PRO">
  <div class="min-h-screen bg-background flex items-center justify-center p-8 relative overflow-hidden font-sans">
     <!-- Background Aura -->
     <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-primary/10 blur-[120px] rounded-full -z-10 pointer-events-none"></div>
     
     <div class="max-w-md w-full relative z-10">
        <div class="text-center mb-12">
           <div class="inline-flex w-20 h-20 bg-surface rounded-3xl items-center justify-center mb-8 shadow-2xl shadow-primary/20 border border-border relative group overflow-hidden">
              <div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <Zap size={36} className="text-primary fill-current relative z-10 group-hover:text-primary-foreground transition-colors" />
           </div>
           <h1 class="text-4xl font-black text-foreground tracking-tighter uppercase mb-2">Corporate <span class="text-primary">Access</span></h1>
           <p class="text-muted text-[10px] font-black uppercase tracking-widest mt-1">Sovereign Enterprise Hub • 2026 Edition</p>
        </div>

        <div class="p-10 rounded-[3rem] bg-surface-elevated border border-border shadow-xl backdrop-blur-sm relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
           <form class="space-y-8 relative z-10" onsubmit="window.location.href='/dashboard'; return false;">
              <div>
                 <label class="block text-[10px] font-black text-muted uppercase tracking-widest mb-3 px-1">Corporate Identity</label>
                 <div class="relative group/input">
                    <Mail className="absolute left-5 top-1/2 -translate-y-1/2 text-muted group-focus-within/input:text-primary transition-colors" size={20} />
                    <input 
                       type="email" 
                       placeholder="name@organization.com" 
                       required
                       class="w-full pl-14 pr-6 py-5 bg-surface border border-border rounded-2xl text-foreground placeholder:text-muted focus:outline-none focus:border-primary/50 transition-all font-bold shadow-inner" 
                    />
                 </div>
              </div>

              <div>
                 <label class="block text-[10px] font-black text-muted uppercase tracking-widest mb-3 px-1">Credentials</label>
                 <div class="relative group/input">
                    <Lock className="absolute left-5 top-1/2 -translate-y-1/2 text-muted group-focus-within/input:text-primary transition-colors" size={20} />
                    <input 
                       type="password" 
                       placeholder="••••••••" 
                       required
                       class="w-full pl-14 pr-6 py-5 bg-surface border border-border rounded-2xl text-foreground placeholder:text-muted focus:outline-none focus:border-primary/50 transition-all font-bold shadow-inner" 
                    />
                 </div>
              </div>

              <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest px-1">
                 <label class="flex items-center gap-2 text-muted hover:text-foreground cursor-pointer transition-all">
                    <input type="checkbox" class="w-4 h-4 bg-surface border-border rounded focus:ring-0 focus:ring-offset-0 text-primary" /> Remember Session
                 </label>
                 <a href="#" class="text-primary hover:brightness-110 transition-colors">Recover Access</a>
              </div>

              <button type="submit" class="w-full py-5 bg-primary hover:brightness-110 text-primary-foreground rounded-[2rem] font-black text-xs uppercase tracking-widest shadow-2xl shadow-primary/30 transition-all active:scale-95 flex items-center justify-center gap-4 group/btn">
                 Enter Platform <ArrowRight size={20} className="group-hover/btn:translate-x-1 transition-transform" />
              </button>
           </form>

           <div class="relative my-10 z-10">
              <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-border"></div></div>
              <div class="relative flex justify-center uppercase text-[9px] font-black bg-surface-elevated px-4 text-muted tracking-widest leading-none">Authentication Gateway</div>
           </div>

           <div class="grid grid-cols-2 gap-4 relative z-10">
              <button class="flex items-center justify-center gap-3 py-4 bg-surface hover:bg-border text-foreground rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all border border-border shadow-sm active:scale-95">
                 <Chrome size={18} class="text-muted" /> Workspace
              </button>
              <button class="flex items-center justify-center gap-3 py-4 bg-surface hover:bg-border text-foreground rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all border border-border shadow-sm active:scale-95">
                 <ShieldCheck size={18} class="text-muted" /> Microsoft
              </button>
           </div>
        </div>

        <div class="text-center mt-12 flex items-center justify-center gap-6">
           <p class="text-muted text-[9px] font-black uppercase tracking-widest">© 2026 BPA Intelligence</p>
           <span class="w-1 h-1 bg-muted rounded-full"></span>
           <p class="text-muted text-[9px] font-black uppercase tracking-widest">RSA-4096 Secure</p>
        </div>
     </div>
  </div>
</MainLayout>

<style is:global>
   /* Force Autocomplete Styling to match dark theme */
   input:-webkit-autofill,
   input:-webkit-autofill:hover, 
   input:-webkit-autofill:focus, 
   input:-webkit-autofill:active{
       -webkit-box-shadow: 0 0 0 1000px hsl(var(--surface)) inset !important;
       -webkit-text-fill-color: hsl(var(--foreground)) !important;
       transition: background-color 5000s ease-in-out 0s;
   }
</style>
