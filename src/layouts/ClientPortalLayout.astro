---
import MainLayout from './MainLayout.astro';
import { LogOut, LayoutDashboard, FileText, CheckSquare, MessageSquare } from 'lucide-react';

interface Props {
  title?: string;
  clientName?: string;
}

const { title, clientName = "Acme Corporation" } = Astro.props;
---

<MainLayout title={title}>
  <div class="min-h-screen bg-slate-50 flex flex-col">
    {/* Portal Topbar */}
    <header class="h-20 bg-white border-b border-slate-200 px-10 flex items-center justify-between sticky top-0 z-40 shadow-sm">
      <div class="flex items-center gap-8">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-slate-900 rounded-xl flex items-center justify-center shadow-lg shadow-slate-900/20">
            <span class="text-white font-black text-lg">BPA</span>
          </div>
          <div>
            <span class="font-bold text-xl tracking-tight text-slate-900">Client<span class="text-violet-600">Portal</span></span>
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-500">{clientName}</p>
          </div>
        </div>
        
        {/* Portal Nav */}
        <nav class="hidden md:flex items-center gap-1 ml-10 border-l border-slate-100 pl-10">
           <a href="/portal" class="px-4 py-2 bg-violet-50 text-violet-600 rounded-xl text-xs font-black uppercase tracking-widest transition-colors flex items-center gap-2"><LayoutDashboard size={16}/> Overview</a>
           <a href="#" class="px-4 py-2 text-slate-500 hover:bg-slate-50 rounded-xl text-xs font-black uppercase tracking-widest transition-colors flex items-center gap-2"><CheckSquare size={16}/> Approvals</a>
           <a href="#" class="px-4 py-2 text-slate-500 hover:bg-slate-50 rounded-xl text-xs font-black uppercase tracking-widest transition-colors flex items-center gap-2"><FileText size={16}/> Invoices</a>
        </nav>
      </div>

      <div class="flex items-center gap-4">
        <button class="w-11 h-11 rounded-2xl bg-white border border-slate-200 flex items-center justify-center text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all shadow-sm active:scale-95">
          <MessageSquare size={20} />
        </button>
        <button class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:text-rose-600 hover:bg-rose-50 hover:border-rose-100 transition-colors">
          <span class="text-[10px] font-black uppercase tracking-widest">Sign Out</span>
          <LogOut size={16} />
        </button>
      </div>
    </header>

    {/* Portal Content */}
    <main class="flex-1 p-10 max-w-7xl mx-auto w-full">
      <slot />
    </main>
  </div>
</MainLayout>
