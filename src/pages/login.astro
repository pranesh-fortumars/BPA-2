---
import MainLayout from '../layouts/MainLayout.astro';
import { Zap, ShieldCheck, Mail, Lock, ArrowRight, Github, Chrome } from 'lucide-react';
---

<MainLayout title="Log in | BPA PRO">
  <div class="min-h-screen bg-white flex items-center justify-center p-8 relative overflow-hidden">
     <!-- Background Aura -->
     <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-violet-600/5 blur-[120px] rounded-full -z-10"></div>
     
     <div class="max-w-md w-full relative z-10">
        <div class="text-center mb-12">
           <div class="inline-flex w-20 h-20 bg-white rounded-3xl items-center justify-center mb-8 shadow-2xl shadow-violet-600/10 border border-slate-100 relative group overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-br from-violet-600 to-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <Zap size={36} className="text-violet-600 fill-current relative z-10 group-hover:text-slate-900 transition-colors" />
           </div>
           <h1 class="text-4xl font-black text-slate-900 tracking-tighter uppercase mb-2">Corporate <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-indigo-600">Access</span></h1>
           <p class="text-slate-600 text-[10px] font-black uppercase tracking-widest mt-1">Sovereign Enterprise Hub • 2026 Edition</p>
        </div>

        <div class="p-10 rounded-[3rem] bg-white border border-slate-100 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.08)] backdrop-blur-sm">
           <form class="space-y-8" onsubmit="window.location.href='/dashboard'; return false;">
              <div>
                 <label class="block text-[10px] font-black text-slate-600 uppercase tracking-widest mb-3 px-1">Corporate Identity</label>
                 <div class="relative group">
                    <Mail className="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-violet-500 transition-colors" size={20} />
                    <input 
                       type="email" 
                       placeholder="name@organization.com" 
                       required
                       class="w-full pl-14 pr-6 py-5 bg-white border border-slate-100 rounded-2xl text-slate-900 placeholder:text-slate-300 focus:outline-none focus:border-violet-500/30 focus:bg-white transition-all font-semibold selection:bg-violet-500/20 shadow-inner" 
                    />
                 </div>
              </div>

              <div>
                 <label class="block text-[10px] font-black text-slate-600 uppercase tracking-widest mb-3 px-1">Credentials</label>
                 <div class="relative group">
                    <Lock className="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-violet-500 transition-colors" size={20} />
                    <input 
                       type="password" 
                       placeholder="••••••••" 
                       required
                       class="w-full pl-14 pr-6 py-5 bg-white border border-slate-100 rounded-2xl text-slate-900 placeholder:text-slate-300 focus:outline-none focus:border-violet-500/30 focus:bg-white transition-all font-semibold selection:bg-violet-500/20 shadow-inner" 
                    />
                 </div>
              </div>

              <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest px-1">
                 <label class="flex items-center gap-2 text-slate-600 hover:text-slate-900 cursor-pointer transition-all">
                    <input type="checkbox" class="w-4 h-4 bg-white border-none rounded focus:ring-0" /> Remember Session
                 </label>
                 <a href="#" class="text-violet-600 hover:text-violet-800 transition-colors">Recover Access</a>
              </div>

              <button type="submit" class="w-full py-5 bg-violet-600 hover:bg-violet-500 text-white rounded-[2rem] font-black text-xs uppercase tracking-widest shadow-2xl shadow-violet-600/30 transition-all active:scale-95 flex items-center justify-center gap-4 group">
                 Enter Platform <ArrowRight size={20} className="group-hover:translate-x-1 transition-transform" />
              </button>
           </form>

           <div class="relative my-10">
              <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-100"></div></div>
              <div class="relative flex justify-center uppercase text-[9px] font-black bg-white px-4 text-slate-300 tracking-widest leading-none">Authentication Gateway</div>
           </div>

           <div class="grid grid-cols-2 gap-4">
              <button class="flex items-center justify-center gap-3 py-4 bg-white hover:bg-white text-slate-900 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all border border-slate-200 shadow-sm active:scale-95">
                 <Chrome size={18} class="text-slate-600" /> Workspace
              </button>
              <button class="flex items-center justify-center gap-3 py-4 bg-white hover:bg-white text-slate-900 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all border border-slate-200 shadow-sm active:scale-95">
                 <ShieldCheck size={18} class="text-slate-600" /> Microsoft
              </button>
           </div>
        </div>

        <div class="text-center mt-12 flex items-center justify-center gap-6">
           <p class="text-slate-300 text-[9px] font-black uppercase tracking-widest">© 2026 BPA Intelligence</p>
           <span class="w-1 h-1 bg-slate-100 rounded-full"></span>
           <p class="text-slate-300 text-[9px] font-black uppercase tracking-widest">RSA-4096 Secure</p>
        </div>
     </div>
  </div>
</MainLayout>

<style is:global>
   /* Force Autocomplete Styling */
   input:-webkit-autofill,
   input:-webkit-autofill:hover, 
   input:-webkit-autofill:focus, 
   input:-webkit-autofill:active{
       -webkit-box-shadow: 0 0 0 1000px #ffffff inset !important;
       -webkit-text-fill-color: #0f1722 !important;
       transition: background-color 5000s ease-in-out 0s;
   }
</style>





